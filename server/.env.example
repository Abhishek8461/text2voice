# Optional: OpenAI API Credentials
# If not provided, EchoVoice automatically uses the free built-in TTS engine with no key required!
# Replace with your actual key from https://platform.openai.com/api-keys if you want OpenAI HD voices
OPENAI_API_KEY=your_openai_api_key_here

# Audio Configuration (Optional overrides)
# Models: tts-1 (standard, fast) or tts-1-hd (high definition)
OPENAI_TTS_MODEL=tts-1

# Voices: alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_VOICE=alloy

# Server Port
PORT=5000
